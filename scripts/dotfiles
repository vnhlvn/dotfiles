#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST_FILE="${ROOT_DIR}/dotfiles.manifest"

DRY_RUN=0
FORCE=0
BACKUP=1
VERBOSE=1

log() {
  if [[ "${VERBOSE}" -eq 1 ]]; then
    printf '%s\n' "$*"
  fi
}

warn() {
  printf 'warning: %s\n' "$*" >&2
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

current_os() {
  case "$(uname -s)" in
    Darwin) echo "macos" ;;
    Linux) echo "linux" ;;
    *) echo "unknown" ;;
  esac
}

applies_to_os() {
  local entry_os="$1"
  local host_os="$2"

  [[ "${entry_os}" == "all" || "${entry_os}" == "${host_os}" ]]
}

applies_to_mode() {
  local entry_mode="$1"
  local action="$2"

  case "${entry_mode}" in
    both|"") return 0 ;;
    install) [[ "${action}" == "install" || "${action}" == "status" || "${action}" == "list" ]] ;;
    sync) [[ "${action}" == "sync" || "${action}" == "status" || "${action}" == "list" ]] ;;
    *) return 1 ;;
  esac
}

expand_path() {
  local value="$1"
  case "${value}" in
    \~/*) printf '%s/%s\n' "${HOME}" "${value#\~/}" ;;
    \~) printf '%s\n' "${HOME}" ;;
    *) printf '%s\n' "${value}" ;;
  esac
}

run_cmd() {
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    printf '[dry-run] %s\n' "$*"
  else
    eval "$@"
  fi
}

ensure_parent_dir() {
  local path="$1"
  local parent
  parent="$(dirname "${path}")"
  run_cmd "mkdir -p \"${parent}\""
}

backup_or_replace_target() {
  local target="$1"

  if [[ ! -e "${target}" && ! -L "${target}" ]]; then
    return 0
  fi

  if [[ "${BACKUP}" -eq 1 ]]; then
    local stamp backup_path
    stamp="$(date +%Y%m%d-%H%M%S)"
    backup_path="${target}.bak.${stamp}"
    log "Backing up ${target} -> ${backup_path}"
    run_cmd "mv \"${target}\" \"${backup_path}\""
    return 0
  fi

  if [[ "${FORCE}" -eq 1 ]]; then
    log "Replacing ${target}"
    run_cmd "rm -rf \"${target}\""
    return 0
  fi

  warn "Skipping ${target} (already exists). Use --force or remove it manually."
  return 1
}

link_entry() {
  local src_rel="$1"
  local target_raw="$2"
  local target src

  src="${ROOT_DIR}/${src_rel}"
  target="$(expand_path "${target_raw}")"

  if [[ ! -e "${src}" && ! -L "${src}" ]]; then
    warn "Source missing, skipping: ${src_rel}"
    return 0
  fi

  if [[ -L "${target}" ]]; then
    local linked_to
    linked_to="$(readlink "${target}" || true)"
    if [[ "${linked_to}" == "${src}" ]]; then
      log "Already linked: ${target} -> ${src}"
      return 0
    fi
  fi

  if ! backup_or_replace_target "${target}"; then
    return 0
  fi

  ensure_parent_dir "${target}"
  run_cmd "ln -s \"${src}\" \"${target}\""
  log "Linked ${target} -> ${src}"
}

copy_back_entry() {
  local src_rel="$1"
  local target_raw="$2"
  local target src

  src="${ROOT_DIR}/${src_rel}"
  target="$(expand_path "${target_raw}")"

  if [[ ! -e "${target}" && ! -L "${target}" ]]; then
    log "Target missing, skipping: ${target}"
    return 0
  fi

  if [[ -L "${target}" ]]; then
    local linked_to
    linked_to="$(readlink "${target}" || true)"
    if [[ "${linked_to}" == "${src}" ]]; then
      log "Linked target, no sync needed: ${target}"
      return 0
    fi
  fi

  ensure_parent_dir "${src}"

  if [[ -d "${target}" && ! -L "${target}" ]]; then
    run_cmd "rm -rf \"${src}\""
    run_cmd "cp -R \"${target}\" \"${src}\""
    log "Synced directory ${target} -> ${src}"
  else
    run_cmd "cp \"${target}\" \"${src}\""
    log "Synced file ${target} -> ${src}"
  fi
}

status_entry() {
  local src_rel="$1"
  local target_raw="$2"
  local target src

  src="${ROOT_DIR}/${src_rel}"
  target="$(expand_path "${target_raw}")"

  if [[ ! -e "${src}" && ! -L "${src}" ]]; then
    printf 'MISSING_SOURCE | %-40s | %s\n' "${src_rel}" "${target}"
    return 0
  fi

  if [[ ! -e "${target}" && ! -L "${target}" ]]; then
    printf 'MISSING_TARGET | %-40s | %s\n' "${src_rel}" "${target}"
    return 0
  fi

  if [[ -L "${target}" ]]; then
    local linked_to
    linked_to="$(readlink "${target}" || true)"
    if [[ "${linked_to}" == "${src}" ]]; then
      printf 'LINKED        | %-40s | %s\n' "${src_rel}" "${target}"
    else
      printf 'WRONG_LINK    | %-40s | %s -> %s\n' "${src_rel}" "${target}" "${linked_to}"
    fi
    return 0
  fi

  if [[ -d "${target}" ]]; then
    printf 'OVERRIDE_DIR  | %-40s | %s\n' "${src_rel}" "${target}"
  else
    if cmp -s "${src}" "${target}"; then
      printf 'MATCH_FILE    | %-40s | %s\n' "${src_rel}" "${target}"
    else
      printf 'OVERRIDE_FILE | %-40s | %s\n' "${src_rel}" "${target}"
    fi
  fi
}

iterate_manifest() {
  local action="$1"
  local host_os

  [[ -f "${MANIFEST_FILE}" ]] || die "Manifest not found: ${MANIFEST_FILE}"

  host_os="$(current_os)"
  [[ "${host_os}" != "unknown" ]] || die "Unsupported OS: $(uname -s)"

  while IFS='|' read -r src_rel target entry_os entry_mode; do
    [[ -n "${src_rel}" ]] || continue
    [[ "${src_rel}" =~ ^# ]] && continue

    if ! applies_to_os "${entry_os}" "${host_os}"; then
      continue
    fi
    if ! applies_to_mode "${entry_mode}" "${action}"; then
      continue
    fi

    case "${action}" in
      install) link_entry "${src_rel}" "${target}" ;;
      sync) copy_back_entry "${src_rel}" "${target}" ;;
      status) status_entry "${src_rel}" "${target}" ;;
      list) printf '%s | %s | %s | %s\n' "${src_rel}" "${target}" "${entry_os}" "${entry_mode:-both}" ;;
      *) die "Unknown action: ${action}" ;;
    esac
  done < "${MANIFEST_FILE}"
}

usage() {
  cat <<USAGE
Usage:
  scripts/dotfiles <install|sync|status|list> [options]

Options:
  --dry-run     Print operations without changing files
  --force       Replace existing files when backup is disabled
  --no-backup   Do not create *.bak.<timestamp> files before linking
  --quiet       Reduce logging noise
USAGE
}

main() {
  local action="${1:-}"
  shift || true

  case "${action}" in
    install|sync|status|list) ;;
    ""|-h|--help) usage; exit 0 ;;
    *) die "Invalid action: ${action}" ;;
  esac

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --force) FORCE=1 ;;
      --no-backup) BACKUP=0 ;;
      --quiet) VERBOSE=0 ;;
      -h|--help) usage; exit 0 ;;
      *) die "Unknown option: $1" ;;
    esac
    shift
  done

  iterate_manifest "${action}"
}

main "$@"
